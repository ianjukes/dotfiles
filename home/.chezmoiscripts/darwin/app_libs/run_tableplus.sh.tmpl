#!/usr/bin/env zsh
set -eufo pipefail
IFS=$'\n\t'

source "{{ .include }}"
src="{{ .filesDir }}/prefs/TablePlus"
pls="com.tinyapp.TablePlus.plist"
dst="$HOME/Library/Application Support/com.tinyapp.TablePlus/Data"
if [[ -f "${src}/connections.tableplusconnection.asc" ]]; then
  restore_app_libs TablePlus 26.10.20 "${src}/${pls}.asc" "$HOME/Library/Preferences/${pls}"
  print -- 'TablePlus connections: use the native import procedure in docs/app-preferences.md.'
else
  # These two plists capture the verified empty lists. Use native exports once populated.
  restore_app_libs TablePlus 26.10.20 \
    "${src}/${pls}.asc" "$HOME/Library/Preferences/${pls}" \
    "${src}/Connections.plist.asc" "${dst}/Connections.plist" \
    "${src}/ConnectionGroups.plist.asc" "${dst}/ConnectionGroups.plist"
fi
