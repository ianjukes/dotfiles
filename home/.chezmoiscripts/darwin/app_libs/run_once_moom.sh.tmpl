#!/usr/bin/env zsh
set -eufo pipefail
IFS=$'\n\t'

{{/* differentiate between laptop and desktop */ -}}
{{ $pre := "desktop." -}}
{{ if hasPrefix "MacBook" .chezmoi.hostname -}}
{{   $pre = "laptop." -}}
{{ end -}}

{{ $prefs := print ".files/prefs/Moom/" $pre "com.manytricks.Moom.plist" -}}
{{ $shared := ".files/prefs/Moom/com.manytricks.Moom.plist" -}}
{{/* Prefer the matching machine snapshot, falling back to a shared snapshot. */ -}}
{{ if and (not (stat (joinPath .chezmoi.sourceDir $prefs))) (stat (joinPath .chezmoi.sourceDir $shared)) -}}
{{   $pre = "" -}}
{{   $prefs = $shared -}}
{{ end -}}
{{ $havePrefs := stat (joinPath .chezmoi.sourceDir $prefs) -}}

# Restore helper: {{ include ".files/lib/macos.sh" | sha256sum }}
# Preferences: {{ if $havePrefs }}{{ include $prefs | sha256sum }}{{ else }}missing{{ end }}
# License: {{ include ".files/prefs/Moom/Ian Jukes.moomlicense.asc" | sha256sum }}
# Upgrade license: {{ include ".files/prefs/Moom/Ian Jukes.moomupgradelicense.asc" | sha256sum }}
# Combo license: {{ include ".files/prefs/Moom/Ian Jukes.moomcombolicense.asc" | sha256sum }}
source "{{ .include }}"

app="Moom"

pls="com.manytricks.Moom.plist"
src="{{ .filesDir }}/prefs/${app}/{{ $pre }}${pls}"
dst="$HOME/Library/Preferences/${pls}"
{{ if $havePrefs -}}
replace_lib "${src}" "${dst}" "${app}" "${pls}"
{{ else -}}
print -u2 -- "Skipping ${app} preferences: missing snapshot ${src} (also checked {{ .filesDir }}/prefs/${app}/${pls})"
{{ end -}}

lic="Ian Jukes.moomlicense"
src="{{ .filesDir }}/prefs/${app}/${lic}.asc"
dst="$HOME/Library/Application Support/Many Tricks/Licenses/${lic}"
replace_lib "${src}" "${dst}" "${app}" "${lic}" true

lic="Ian Jukes.moomupgradelicense"
src="{{ .filesDir }}/prefs/${app}/${lic}.asc"
dst="$HOME/Library/Application Support/Many Tricks/Licenses/${lic}"
replace_lib "${src}" "${dst}" "${app}" "${lic}" true

lic="Ian Jukes.moomcombolicense"
src="{{ .filesDir }}/prefs/${app}/${lic}.asc"
dst="$HOME/Library/Application Support/Many Tricks/Licenses/${lic}"
replace_lib "${src}" "${dst}" "${app}" "${lic}" true
