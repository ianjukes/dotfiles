#!/usr/bin/env zsh
set -eufo pipefail
IFS=$'\n\t'

{{ $src := "dot_config/tmux/plugins/external_tmux/scripts/cwd.sh" -}}
{{ $dst := "$HOME/.config/tmux/plugins/tmux/scripts/cwd.sh" -}}

# Trigger script if cwd.sh has changed
# Hash: {{ include $src | sha256sum }}

src="{{ print .chezmoi.sourceDir "/" $src }}"
dst="{{ $dst }}"

if [[ -L "${dst}" || ( -e "${dst}" && ! -f "${dst}" ) ]]; then
  print -u2 -- "Refusing to replace non-regular tmux script: ${dst}"
  exit 1
fi
mkdir -p "${dst:h}"
tmp=$(mktemp "${dst:h}/.cwd.sh.XXXXXX")
trap 'rm -f -- "${tmp}"' EXIT
trap 'exit 1' HUP INT TERM
cp -p "${src}" "${tmp}"
sed -i '' "s|cwd=\"\${path/\"\$HOME\"/'~'}|cwd=\"\${path/\"\$HOME\"/~}|g" "${tmp}"
if [[ ! -f "${dst}" ]] || ! cmp -s "${tmp}" "${dst}"; then
  mv -f "${tmp}" "${dst}"
fi
